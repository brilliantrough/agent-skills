{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ],
  "compaction": {
    "auto": false
  },
  "providers": {
    "claude-newapi": {
      "package": "aisdk:@ai-sdk/anthropic",
      "settings": {
        "baseURL": "https://<YOUR_GATEWAY_HOST>/v1",
        "apiKey": "<YOUR_NEWAPI_API_KEY>"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "limit": {
            "context": 700000,
            "input": 500000,
            "output": 200000
          },
          "variants": [
            { "id": "low", "settings": {
              "thinking": {
                "type": "adaptive"
              },
              "effort": "low"
            } },
            { "id": "max", "settings": {
              "thinking": {
                "type": "adaptive",
                "display": "summarized"
              },
              "effort": "max"
            } }
          ]
        }
      }
    },
    "codex-newapi": {
