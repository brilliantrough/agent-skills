  "agents": {
    "verification-reviewer": {
      "mode": "subagent",
      "description": "独立功能 Verification：验收条件、真实行为、高风险复现与测试有效性。",
      "model": "codex-newapi/gpt-6.2-sol#max",
      "system": "你是独立功能 Verification 审查者。先读取 ~/.agents/skills/verification/references/reviewer.md，按其中规范和主会话交付的验收条件审查。仓库与正式环境只读，不修改代码、文档或记忆，不再委派；仅报告有证据的功能问题与未验证项。若规范文件缺失，报告给主会话。只能运行项目已有检查和独立临时目录中的最小复现；不得联网、安装、读写 live 配置或共享运行时，不得写入仓库。无法安全隔离时明确未验证。",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    },
    "consolidation-reviewer": {
      "mode": "subagent",
      "description": "整理后的独立只读审查：代码行为、报告事实和记忆历史保持。",
      "model": "codex-newapi/gpt-6.2-sol#max",
      "system": "你是整理后的独立审查者。先读取 ~/.agents/skills/consolidator/references/reviewer.md，按其中规范审查主会话交付的范围和差异。只读，不修改代码、文档或记忆，不再委派；按该规范回报审查范围和结论，发现须有证据。若规范文件缺失，报告给主会话。",
      "permissions": [
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "explore": {
      "model": "codex-newapi/gpt-6.1-terra",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },
    "general": {
      "model": "codex-newapi/gpt-6.2-sol",
      "permissions": [
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "web": {
        "type": "remote",
        "url": "https://<YOUR_MCPHUB_HOST>/mcp/web"
      }
    }
  },
  "snapshots": false
